# Copy to backend/.env and adjust. All keys are optional.
CF_ENABLE_YOUTUBE=true
CF_MAX_DURATION_SEC=3600
CF_MAX_FILESIZE_MB=1024
CF_MAX_CONCURRENT_JOBS=4
CF_RESOLVE_RATE_PER_MIN=20
CF_JOBS_RATE_PER_MIN=15
CF_FILE_TTL_SEC=900
# Residential/rotating proxy - needed in production for TikTok/Instagram, which block datacenter IPs.
# CF_PROXY=http://user:pass@host:port
# CF_COOKIES_FILE=cookies.txt
# Fallback API (RapidAPI "Social Media Video Downloader") for YouTube + Instagram when the
# server's IP is blocked. Used only when yt-dlp fails; 1 credit per link. Empty = off.
# CF_RAPIDAPI_KEY=
# CF_RAPIDAPI_HOST=social-media-video-downloader.p.rapidapi.com
# CF_FFMPEG_LOCATION=D:\tools\ffmpeg\bin
CF_CORS_ORIGINS=["http://localhost:3000"]

# ---- Reframe tool (landscape -> portrait)
CF_UPLOAD_MAX_MB=1024
CF_REFRAME_MAX_DURATION_SEC=1800
CF_REFRAME_ALLOW_LINKS=true
# Videos processed at once. Each one keeps ~2-4 CPU cores busy: 1 per 4 vCPU is a good start.
CF_REFRAME_WORKERS=1
CF_REFRAME_QUEUE_MAX=25
CF_REFRAME_DAILY_PER_IP=40
# Uploads and results are deleted after this many seconds (24 h).
CF_REFRAME_TTL_SEC=86400
CF_REFRAME_MIN_FREE_GB=2
CF_REFRAME_RENDER_MAX_HEIGHT=1440
CF_REFRAME_THREADS=2

# ---- Captions tool (AI captions)
# Speech to text, tried in this order (a provider whose free limit is used up is skipped until it resets):
# 1. Groq: Whisper large-v3-turbo. FREE tier, no card: ~8 h of audio/day, 2,000 requests/day.
#    Key: https://console.groq.com/keys . The same key also gives free AI translation / Roman Urdu /
#    highlights (CF_GROQ_LLM_MODEL) when there's no Anthropic key.
# CF_GROQ_API_KEY=
# CF_GROQ_LLM_MODEL=openai/gpt-oss-120b
# 2. Cloudflare Workers AI: the same Whisper model. FREE: 10,000 neurons/day (~3.5 h of audio).
#    Dashboard -> Workers AI -> "Use REST API": account ID + an API token with Workers AI permission.
# CF_CLOUDFLARE_ACCOUNT_ID=
# CF_CLOUDFLARE_API_TOKEN=
# Urdu/Hindi/Punjabi... use the full whisper-large-v3 on Groq (turbo is weaker for these languages).
# After speech-to-text, the AI fixes misheard words using the whole transcript (timings kept). Free with Groq.
CF_CAPTIONS_AI_PROOFREAD=true
# 3. faster-whisper on this server's CPU: always there, slower and less accurate.
#    tiny | base | small | medium (the Docker image ships "small", build arg WHISPER_PRELOAD).
CF_LOCAL_WHISPER_MODEL=small
CF_LOCAL_WHISPER_FALLBACK=true
# Optional, paid, best quality for the AI text features (preferred over Groq when set).
# CF_ANTHROPIC_API_KEY=
CF_ANTHROPIC_MODEL=claude-opus-5-5
CF_CAPTIONS_MAX_DURATION_SEC=3600
CF_CAPTIONS_DAILY_PER_IP=30
CF_CAPTIONS_AI_DAILY_PER_IP=60
CF_CAPTIONS_RENDERS_PER_HOUR=40
CF_CAPTIONS_WORKERS=2
CF_CAPTIONS_QUEUE_MAX=40
CF_CAPTIONS_THREADS=4
CF_CAPTIONS_WATERMARK=klyprima.com

# ---- AI Clips (long video -> short clips): uses the caption keys above (speech-to-text + text AI) and the
# Reframe models. Without an AI key, an offline moment scorer picks the clips.
CF_CLIPS_MAX_DURATION_SEC=5400
CF_CLIPS_DAILY_PER_IP=10
CF_CLIPS_FINDS_PER_DAY=30
CF_CLIPS_RENDERS_PER_HOUR=80
CF_CLIPS_WORKERS=1
CF_CLIPS_QUEUE_MAX=20
CF_CLIPS_ACTIVE_PER_IP=1
