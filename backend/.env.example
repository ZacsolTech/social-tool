# Copy to backend/.env and adjust. All keys are optional.
CF_ENABLE_YOUTUBE=true
CF_MAX_DURATION_SEC=3600
CF_MAX_FILESIZE_MB=1024
CF_MAX_CONCURRENT_JOBS=4
CF_RESOLVE_RATE_PER_MIN=20
CF_JOBS_RATE_PER_MIN=15
CF_FILE_TTL_SEC=900
# Residential/rotating proxy - needed in production for TikTok/Instagram, which block datacenter IPs.
# CF_PROXY=http://user:pass@host:port
# CF_COOKIES_FILE=cookies.txt
# CF_FFMPEG_LOCATION=D:\tools\ffmpeg\bin
CF_CORS_ORIGINS=["http://localhost:3000"]
